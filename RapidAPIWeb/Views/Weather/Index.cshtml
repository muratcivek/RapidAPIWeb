@model RapidAPIWeb.Models.WeatherViewModel

@{
    ViewData["Title"] = "Hava Durumu";

    double FahrenheitToCelsius(double fahrenheit)
    {
        return (fahrenheit - 32) * 5 / 9;
    }
}

<div class="container mt-5">

    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="card shadow border-0 mb-4">
                <div class="card-body p-4">

                    <h3 class="mb-4">
                        Hava Durumu
                    </h3>

                    <form asp-controller="Weather"
                          asp-action="Index"
                          method="post">

                        <div class="input-group">

                            <input type="text"
                                   name="city"
                                   class="form-control"
                                   placeholder="Şehir giriniz... Örn: İstanbul"
                                   required />

                            <button type="submit"
                                    class="btn btn-primary">
                                Ara
                            </button>

                        </div>

                    </form>

                </div>
            </div>


            @if (Model != null)
            {
                var weather = Model.Weather?.FirstOrDefault();

                var temp = FahrenheitToCelsius(Model.Main.Temp);
                var feelsLike = FahrenheitToCelsius(Model.Main.FeelsLike);
                var tempMin = FahrenheitToCelsius(Model.Main.TempMin);
                var tempMax = FahrenheitToCelsius(Model.Main.TempMax);

                <div class="card shadow border-0">

                    <div class="card-body p-4">

                        <div class="d-flex justify-content-between align-items-center mb-4">

                            <div>

                                <h2 class="mb-1">
                                    @Model.Name
                                </h2>

                                <span class="text-muted">
                                    @Model.Sys.Country
                                </span>

                            </div>

                            @if (weather != null)
                            {
                                <img src="https://openweathermap.org/img/wn/@(weather.Icon)@@2x.png"
                                     alt="@weather.Description"
                                     width="80"
                                     height="80" />
                            }

                        </div>


                        <div class="text-center mb-4">

                            <div class="display-3 fw-bold">
                                @temp.ToString("0.0") °C
                            </div>

                            @if (weather != null)
                            {
                                <div class="fs-5 text-capitalize text-muted">
                                    @weather.Description
                                </div>
                            }

                            <div class="text-muted mt-2">
                                Hissedilen: @feelsLike.ToString("0.0") °C
                            </div>

                        </div>


                        <hr />


                        <div class="row text-center mt-4">

                            <div class="col-md-3 col-6 mb-4">

                                <div class="text-muted">
                                    Nem
                                </div>

                                <strong class="fs-5">
                                    %@Model.Main.Humidity
                                </strong>

                            </div>


                            <div class="col-md-3 col-6 mb-4">

                                <div class="text-muted">
                                    Rüzgar
                                </div>

                                <strong class="fs-5">
                                    @Model.Wind.Speed mph
                                </strong>

                            </div>


                            <div class="col-md-3 col-6 mb-4">

                                <div class="text-muted">
                                    Basınç
                                </div>

                                <strong class="fs-5">
                                    @Model.Main.Pressure hPa
                                </strong>

                            </div>


                            <div class="col-md-3 col-6 mb-4">

                                <div class="text-muted">
                                    Bulut
                                </div>

                                <strong class="fs-5">
                                    %@Model.Clouds.All
                                </strong>

                            </div>

                        </div>


                        <div class="row mt-2">

                            <div class="col-md-6">

                                <div class="border rounded p-3">

                                    <span class="text-muted">
                                        En Düşük
                                    </span>

                                    <div class="fs-4 fw-bold">
                                        @tempMin.ToString("0.0") °C
                                    </div>

                                </div>

                            </div>


                            <div class="col-md-6 mt-3 mt-md-0">

                                <div class="border rounded p-3">

                                    <span class="text-muted">
                                        En Yüksek
                                    </span>

                                    <div class="fs-4 fw-bold">
                                        @tempMax.ToString("0.0") °C
                                    </div>

                                </div>

                            </div>

                        </div>


                        <hr class="my-4" />


                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <strong>Görüş Mesafesi:</strong>

                                @(Model.Visibility / 1000.0) km

                            </div>


                            <div class="col-md-6 mb-3">

                                <strong>Koordinat:</strong>

                                @Model.Coord.Lat,
                                @Model.Coord.Lon

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    </div>

</div>
